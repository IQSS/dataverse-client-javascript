{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["jest", "node"]
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "jest.config.integration.ts",
    "jest.config.ts",
    "jest.config.unit.ts",
    "jest.config.functional.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
